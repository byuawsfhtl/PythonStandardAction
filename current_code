import os

import os

def save_python_files_to_output(start_dir: str, output_file: str = 'current_code') -> None:
    """
    Recursively walks through a directory, appending the relative paths and contents of .py files to a file.

    Args:
        start_dir (str): The root directory to start walking from.
        output_file (str): The file to append the output to.
    """
    with open(output_file, 'a', encoding='utf-8') as out:
        for root, _, files in os.walk(start_dir):
            for file in files:
                if file.endswith('.py'):
                    rel_path = os.path.relpath(os.path.join(root, file), start_dir)
                    out.write(f"\n=== {rel_path} ===\n")
                    try:
                        with open(os.path.join(root, file), 'r', encoding='utf-8') as f:
                            out.write(f.read() + "\n")
                    except Exception as e:
                        out.write(f"Error reading {rel_path}: {e}\n")


if __name__ == '__main__':
    save_python_files_to_output('.')

