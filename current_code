@dataclass
class StyleError:
    """Represents a style violation."""
    file_path: str
    line_number: int
    column: int
    error_code: str
    message: str
    
    def __str__(self) -> str:
        """Converts the error dataclass to a string.

        Returns:
            str: the error as a str
        """
        return f"{self.file_path}:{self.line_number}:{self.column}: {self.error_code} {self.message}"


